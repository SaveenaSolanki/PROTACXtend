# PROTACPilot environment configuration
# Source this file: source env/protacpilot.env

# --- PDB directories ---
export PROTACPILOT_PDB_DIR="/storage/saveena/protacpilot/pdb"
export PROTACPILOT_WORK_DIR="/storage/saveena/protacpilot/work"

# --- P4ward ---
export PROTACPILOT_P4WARD_MODE="docker"
export PROTACPILOT_P4WARD_IMAGE="paulajlr/p4ward:latest"
export PROTACPILOT_P4WARD_CPU="8"
export PROTACPILOT_P4WARD_OUTPUT="${PROTACPILOT_WORK_DIR}/p4ward_output"

# --- Docking ---
export PROTACPILOT_TARGET_PDB=""   # Set per-run: export PROTACPILOT_TARGET_PDB=/path/to/target.pdb

# --- PDB structure cache ---
export PROTACPILOT_ALPHAFOLD_CACHE="${PROTACPILOT_PDB_DIR}/alphafold"
export PROTACPILOT_PDB_CACHE="${PROTACPILOT_PDB_DIR}/rcsb"
